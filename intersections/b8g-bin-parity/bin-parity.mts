#!/usr/bin/env node
/**
 * B8G Bin Parity — Single-Source Triplet Projector & Invariant Verifier.
 *
 * Mathematical Invariant:
 *   For every CLI tool `T` in `bin/`, ALL THREE host-shell projections MUST exist:
 *     1. `bin/<T>.ps1`  (PowerShell / pwsh)
 *     2. `bin/<T>.cmd`  (Windows cmd.exe with `chcp 65001 >nul` UTF-8)
 *     3. `bin/<T>`      (POSIX sh / bash / WSL)
 *
 * Eliminates the entire class of single-shell hand-written wrapper bugs.
 */
import { readdirSync, readFileSync, writeFileSync, statSync, existsSync } from 'node:fs';
import { join, resolve, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
const DEFAULT_ROOT = resolve(__dirname, '..', '..');

const IGNORED_ENTRIES = new Set(['completions']);
const NON_WRAPPER_EXTS = ['.b8e', '.exe', '.dll', '.json', '.md'];

export interface ParityViolation {
  tool: string;
  present: string[];
  missing: string[];
}

export interface ParityReport {
  binDir: string;
  totalTools: number;
  compliantTools: number;
  violations: ParityViolation[];
}

function classifyTool(fileName: string): { tool: string; kind: 'posix' | 'cmd' | 'ps1' } | null {
  if (IGNORED_ENTRIES.has(fileName)) return null;
  for (const ext of NON_WRAPPER_EXTS) {
    if (fileName.endsWith(ext)) return null;
  }
  if (fileName.endsWith('.ps1')) return { tool: fileName.slice(0, -4), kind: 'ps1' };
  if (fileName.endsWith('.cmd')) return { tool: fileName.slice(0, -4), kind: 'cmd' };
  return { tool: fileName, kind: 'posix' };
}

export function auditBinParity(binDir: string): ParityReport {
  const entries = readdirSync(binDir);
  const map = new Map<string, Set<'posix' | 'cmd' | 'ps1'>>();

  for (const name of entries) {
    const full = join(binDir, name);
    try {
      if (statSync(full).isDirectory()) continue;
    } catch {
      continue;
    }
    const cls = classifyTool(name);
    if (!cls) continue;
    if (!map.has(cls.tool)) map.set(cls.tool, new Set());
    map.get(cls.tool)!.add(cls.kind);
  }

  const required: Array<'posix' | 'cmd' | 'ps1'> = ['posix', 'cmd', 'ps1'];
  const violations: ParityViolation[] = [];

  for (const [tool, kinds] of [...map.entries()].sort((a, b) => a[0].localeCompare(b[0]))) {
    const missing = required.filter((k) => !kinds.has(k));
    if (missing.length > 0) {
      violations.push({
        tool,
        present: [...kinds].sort(),
        missing,
      });
    }
  }

  return {
    binDir,
    totalTools: map.size,
    compliantTools: map.size - violations.length,
    violations,
  };
}

/**
 * Atomically stamps out all 3 projections (`.ps1`, `.cmd` with UTF-8 chcp 65001, POSIX `sh`)
 * for a workspace `.mts`/`.mjs`/`.ts` entrypoint.
 */
export function stampNodeTriplet(binDir: string, toolName: string, relScriptPath: string): string[] {
  const posixPath = relScriptPath.replace(/\\/g, '/').replace(/^\.\//, '');
  const winPath = posixPath.replace(/\//g, '\\');

  const ps1Content = [
    `# B8G Atomic Triplet Wrapper (${toolName}) — generated by b8g-bin-parity`,
    `$ErrorActionPreference = 'Stop'`,
    `$Root = Split-Path -Parent $PSScriptRoot`,
    `& (Join-Path $PSScriptRoot 'node.ps1') (Join-Path $Root '${winPath}') @args`,
    `exit $LASTEXITCODE`,
    '',
  ].join('\r\n');

  const cmdContent = [
    `@echo off`,
    `setlocal`,
    `chcp 65001 >nul`,
    `"%~dp0node.cmd" "%~dp0..\\${winPath}" %*`,
    `exit /b %ERRORLEVEL%`,
    '',
  ].join('\r\n');

  const shContent = [
    `#!/usr/bin/env sh`,
    `DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"`,
    `exec "$DIR/node" "$DIR/../${posixPath}" "$@"`,
    '',
  ].join('\n');

  const fPs1 = join(binDir, `${toolName}.ps1`);
  const fCmd = join(binDir, `${toolName}.cmd`);
  const fSh = join(binDir, toolName);

  writeFileSync(fPs1, ps1Content, 'utf8');
  writeFileSync(fCmd, cmdContent, 'utf8');
  writeFileSync(fSh, shContent, 'utf8');
  return [fPs1, fCmd, fSh];
}

/**
 * Attempts to heal orphaned `.ps1`/`.cmd` wrappers in `bin/` by inferring their
 * underlying workspace target or delegating cleanly to their sibling wrapper.
 */
export function healBinParity(binDir: string): string[] {
  const report = auditBinParity(binDir);
  const created: string[] = [];

  for (const v of report.violations) {
    const fPs1 = join(binDir, `${v.tool}.ps1`);
    const fCmd = join(binDir, `${v.tool}.cmd`);
    const fSh = join(binDir, v.tool);

    // Check if existing .ps1 or .cmd references a workspace .mts/.mjs/.js script
    let relScript: string | null = null;
    if (existsSync(fPs1)) {
      const txt = readFileSync(fPs1, 'utf8');
      const m = txt.match(/['"]([A-Za-z0-9_.\-\\/]+\.(?:mts|mjs|ts|js))['"]/);
      if (m) relScript = m[1];
    }
    if (!relScript && existsSync(fCmd)) {
      const txt = readFileSync(fCmd, 'utf8');
      const m = txt.match(/%~dp0\.\.\\([A-Za-z0-9_.\-\\]+\.(?:mts|mjs|ts|js))/i);
      if (m) relScript = m[1];
    }

    if (relScript) {
      stampNodeTriplet(binDir, v.tool, relScript);
      created.push(...v.missing.map((k) => `${v.tool} (${k}) -> ${relScript}`));
      continue;
    }

    // Fallback: delegate missing twins to existing .cmd or .ps1 wrapper
    if (v.missing.includes('cmd') && existsSync(fPs1)) {
      writeFileSync(
        fCmd,
        `@echo off\r\nsetlocal\r\nchcp 65001 >nul\r\npwsh -NoProfile -ExecutionPolicy Bypass -File "%~dp0${v.tool}.ps1" %*\r\nexit /b %ERRORLEVEL%\r\n`,
        'utf8',
      );
      created.push(`${v.tool} (cmd) -> pwsh delegate`);
    }
    if (v.missing.includes('ps1') && existsSync(fCmd)) {
      writeFileSync(
        fPs1,
        `$ErrorActionPreference = 'Stop'\r\n& cmd.exe /c "\`"$PSScriptRoot\\${v.tool}.cmd\`" $($args -join ' ')"\r\nexit $LASTEXITCODE\r\n`,
        'utf8',
      );
      created.push(`${v.tool} (ps1) -> cmd delegate`);
    }
    if (v.missing.includes('posix')) {
      writeFileSync(
        fSh,
        `#!/usr/bin/env sh\nDIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"\nexec cmd.exe /c "$DIR/${v.tool}.cmd" "$@"\n`,
        'utf8',
      );
      created.push(`${v.tool} (posix) -> delegate`);
    }
  }

  return created;
}

if (process.argv[1] && resolve(process.argv[1]) === resolve(__filename)) {
  const args = process.argv.slice(2);
  const cmd = args[0] ?? 'verify';
  const binDir = join(DEFAULT_ROOT, 'bin');

  if (cmd === 'verify') {
    const report = auditBinParity(binDir);
    if (report.violations.length === 0) {
      console.log(
        `[b8g-bin-parity] PASS: ${report.compliantTools}/${report.totalTools} tools have complete atomic (posix, cmd, ps1) triplets.`,
      );
      process.exit(0);
    } else {
      console.error(
        `[b8g-bin-parity] FAIL: ${report.violations.length} / ${report.totalTools} tools have incomplete shell triplets:`,
      );
      for (const v of report.violations) {
        console.error(`  - ${v.tool}: present=[${v.present.join(',')}] missing=[${v.missing.join(',')}]`);
      }
      process.exit(1);
    }
  } else if (cmd === 'stamp') {
    const toolName = args[1];
    const relScript = args[2];
    if (!toolName || !relScript) {
      console.error('Usage: b8g-bin-parity stamp <tool-name> <relative-script-path>');
      process.exit(2);
    }
    const files = stampNodeTriplet(binDir, toolName, relScript);
    console.log(`[b8g-bin-parity] Stamped atomic triplet for "${toolName}":\n  ${files.join('\n  ')}`);
  } else if (cmd === 'heal') {
    const healed = healBinParity(binDir);
    console.log(`[b8g-bin-parity] Healed ${healed.length} missing projections:`);
    for (const h of healed) console.log(`  + ${h}`);
    const after = auditBinParity(binDir);
    console.log(
      `[b8g-bin-parity] Post-heal: ${after.compliantTools}/${after.totalTools} compliant (${after.violations.length} violations).`,
    );
    process.exit(after.violations.length === 0 ? 0 : 1);
  } else {
    console.error(`Unknown subcommand: ${cmd}. Expected: verify | stamp | heal`);
    process.exit(2);
  }
}
